{
    "experiment_name": "wire_ablation",
    "paths": {
        "feat_dir": "../model/cpg_features",
        "bucket_dir": "../Dataset_for_first/cleaned_buckets_no_comments",
        "checkpoint_dir": "../checkpoints/metp",
        "log_dir": "../logs/metp"
    },
    "model": {
        "base_model": "answerdotai/ModernBERT-base",
        "max_seq_len": 2048,
        "mlm_weight": 1.0,
        "edge_weight": 0.5
    },
    "training": {
        "batch_size": 16,
        "grad_accum": 4,
        "epochs": 10,
        "lr_encoder": 2e-5,
        "lr_rope": 1e-4,
        "lr_head": 2e-5,
        "warmup_steps": 2000,
        "max_grad_norm": 0.5
    },
    "logging": {
        "log_every": 20,
        "val_every": 500,
        "save_every": 2000
    }
}