{
    "experiment_name": "wire_ablation_8192",
    "paths": {
        "feat_dir": "model/cpg_features",
        "bucket_dir": "Dataset_for_first/cleaned_buckets_no_comments",
        "checkpoint_dir": "checkpoints/wire_abl_8192",
        "log_dir": "logs/wire_abl_8192"
    },
    "model": {
        "base_model": "answerdotai/ModernBERT-base",
        "max_seq_len": 8192,
        "mlm_weight": 1.0,
        "err_weight": 0.2
    },
    "training": {
        "batch_size": 4,
        "grad_accum": 16,
        "epochs": 10,


        "lr_encoder": 2e-5,
        "lr_rope": 1e-4,
        "lr_head": 2e-5,
        "warmup_steps": 2000,
        "max_grad_norm": 0.5
    },
    "logging": {
        "log_every": 100,
        "val_every": 1000,
        "save_every": 2000
    }
}